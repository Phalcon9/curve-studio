# RPC endpoints. Devnet works with the public one; the public mainnet endpoint
# returns 403 to browsers, so mainnet needs your own (e.g. a free Helius key).
VITE_DEVNET_RPC=https://api.devnet.solana.com
VITE_MAINNET_RPC=

# Wallet that earns the referral share on swaps placed in the app (optional).
# Open its token accounts with: pnpm setup-referral <wallet> mainnet-beta <payer.json>
VITE_REFERRAL_WALLET=
